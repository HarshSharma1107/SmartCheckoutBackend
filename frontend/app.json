{
  "expo": {
    "name": "SmartCheckout",
    "slug": "smartcheckout",
    "scheme": "smartcheckout",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartcheckout.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SmartCheckout needs camera access to scan product barcodes at checkout."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.smartcheckout.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SmartCheckout needs camera access to scan product barcodes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0A0A0F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3cf12578-643d-42f0-97d7-8ef341895522"
      }
    }
  }
}