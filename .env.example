DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/1
MQTT_BROKER_URL=mqtts://HOST:8883
S3_BUCKET_INVOICES=your-invoice-bucket-name
WHATSAPP_GRAPH_VERSION=v19.0

EXPO_PUBLIC_API_URL=https://smartcheckout-backend.onrender.com
EXPO_PUBLIC_LOCKED_STORE_ID=

LAN_IP=192.168.1.100
POSTGRES_DB=smartcheckout
POSTGRES_USER=smartcheckout
POSTGRES_PASSWORD=smartcheckout

# Mailbox used to send order receipts. SMTP_PASSWORD must be an app
# password (e.g. Gmail App Password), not the account login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your-admin-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=SmartCheckout
