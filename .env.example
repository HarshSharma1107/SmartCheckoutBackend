LAN_IP=192.168.1.100

# If using PostgreSQL on the host machine from Docker, use host.docker.internal.
# If using a cloud DB, put the cloud connection string here.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@host.docker.internal:5432/YOUR_DB_NAME

# Docker local database defaults.
POSTGRES_DB=smartcheckout
POSTGRES_USER=smartcheckout
POSTGRES_PASSWORD=smartcheckout

# Optional: lock the frontend kiosk/cart to one store UUID.
EXPO_PUBLIC_LOCKED_STORE_ID=
